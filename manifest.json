{
  "manifest_version": 3,
  "name": "World Time Buddy",
  "version": "1.3.0",
  "description": "worldtimebuddy.com in a slim popup, using your existing logged-in session.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "World Time Buddy"
  },
  "host_permissions": [
    "https://www.worldtimebuddy.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.worldtimebuddy.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "cookie-fix.js"
      ]
    },
    {
      "matches": [
        "https://www.worldtimebuddy.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "slim.js"
      ],
      "css": [
        "slim.css"
      ]
    }
  ],
  "permissions": [
    "cookies"
  ],
  "background": {
    "service_worker": "background.js"
  }
}